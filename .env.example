# VaultPi Control Center
# The installer copies this file to .env and fills the secrets automatically.
# Quote values that contain spaces so the file is also valid for systemd.

# Required secrets
VAULTPI_SECRET_KEY=replace-with-a-long-random-secret
BRIDGE_PSK=replace-with-a-long-random-shared-secret

# Web server
CC_HOST=0.0.0.0
CC_PORT=8000

# General app settings
APP_NAME="VaultPi Control Center"
DASHBOARD_TITLE="VaultPi Control Center"
REFRESH_INTERVAL=60
MONITOR_INTERVAL=60
HISTORY_RETENTION=500
CONTROL_CENTER_CONFIG_PATH=config/control_center.json
HOSTNAME_LABEL=
THEME=auto

# External services
FILEBROWSER_URL=
GITEA_URL=
GITEA_CONFIG_PATH=/etc/gitea/app.ini
N8N_URL=

# Runtime paths
LOCAL_BACKUP_DIR=/backup/gitea
LOCAL_REPO_ROOT=/var/lib/gitea/data/gitea-repositories
GITEA_BACKUP_SCRIPT_PATH=/usr/local/bin/gitea-backup.sh
GITEA_SCRIPT_BACKUP_DIR=/usr/local/bin/script-backups

# Optional backup email notifications
BACKUP_EMAIL_TO=
BACKUP_EMAIL_FROM=
MSMTP_BIN=/usr/bin/msmtp

# Safety / guardrails
OPS_MIN_DISK_FREE_PERCENT=15
OPS_MIN_DISK_FREE_GB=10
OPS_BACKUP_MAX_AGE_HOURS=36
OPS_BACKUP_DIR_WARN_GB=30
OPS_HEALTHCHECK_MAX_AGE_DAYS=7

# Footer branding (leave blank to hide the footer link entirely)
BRAND_LINK_TEXT="Created by Djuro Ivankovic"
BRAND_LINK_URL=https://github.com/rimedag

# Feature flags
AUTH_ENABLED=1
COMMAND_EXECUTION_ENABLED=1
MODULE_PROJECTS=1
MODULE_LOCAL_SERVICES=1
MODULE_REMOTE_SERVICES=1
MODULE_ACTIONS=1
MODULE_LOGS=1
